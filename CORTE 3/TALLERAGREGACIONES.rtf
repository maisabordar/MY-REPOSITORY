// 1. Total de minutos y kil\'f3metros por usuario (concatenando nombre y apellido)\
db.corredores.aggregate([\
  \{\
    $group: \{\
      _id: \{ $concat: ["$nombre", " ", "$apellido"] \},\
      "total minutos": \{ $sum: "$minutos" \},\
      "total kilometros": \{ $sum: "$kilometros" \}\
    \}\
  \}\
])\
\
// 2. Promedio de minutos mensuales por corredor\
db.corredores.aggregate([\
  \{\
    $group: \{\
      _id: \{ corredor: \{ $concat: ["$nombre", " ", "$apellido"] \}, mes: "$mes" \},\
      "minutos en el mes": \{ $sum: "$minutos" \}\
    \}\
  \},\
  \{\
    $group: \{\
      _id: "$_id.corredor",\
      "promedio minutos mensuales": \{ $avg: "$minutos en el mes" \}\
    \}\
  \}\
])\
\
// 3. Promedio de kil\'f3metros mensuales por corredor, solo si promedio > 5\
db.corredores.aggregate([\
  \{\
    $group: \{\
      _id: \{ corredor: \{ $concat: ["$nombre", " ", "$apellido"] \}, mes: "$mes" \},\
      "km en el mes": \{ $sum: "$kilometros" \}\
    \}\
  \},\
  \{\
    $group: \{\
      _id: "$_id.corredor",\
      "promedio km mensuales": \{ $avg: "$km en el mes" \}\
    \}\
  \},\
  \{\
    $match: \{ "promedio km mensuales": \{ $gt: 5 \} \}\
  \}\
])\
\
// 4. Total de kil\'f3metros agrupados por corredor y mes, ordenados por mes\
db.corredores.aggregate([\
  \{\
    $group: \{\
      _id: \{ corredor: \{ $concat: ["$nombre", " ", "$apellido"] \}, mes: "$mes" \},\
      "total kilometros": \{ $sum: "$kilometros" \}\
    \}\
  \},\
  \{\
    $sort: \{ "_id.mes": 1 \}\
  \}\
])\
\
// 5. Distancias recorridas por corredor usando $addToSet\
db.corredores.aggregate([\
  \{\
    $group: \{\
      _id: \{ $concat: ["$nombre", " ", "$apellido"] \},\
      "distancias": \{ $addToSet: "$kilometros" \}\
    \}\
  \}\
])\
\
// 6. Cu\'e1ntos corredores est\'e1n interesados en cada afici\'f3n usando $unwind\
db.corredores.aggregate([\
  \{\
    $unwind: "$aficiones"\
  \},\
  \{\
    $group: \{\
      _id: "$aficiones",\
      "total corredores": \{ $sum: 1 \}\
    \}\
  \}\
