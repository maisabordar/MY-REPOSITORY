\f0\fs24 \cf0 // 1. Cantidad de empleados agrupados por g\'e9nero, ordenados de menor a mayor\
db.employee.aggregate([\
  \{\
    $group: \{\
      _id: "$gender",\
      "cantidad empleados": \{ $sum: 1 \}\
    \}\
  \},\
  \{\
    $sort: \{ "cantidad empleados": 1 \}\
  \}\
])\
\
// 2. Auxiliares de est\'e9tica por g\'e9nero, ordenados ascendente por g\'e9nero\
db.employee.aggregate([\
  \{\
    $match: \{ jobtitle: "Auxiliar de est\'e9tica" \}\
  \},\
  \{\
    $group: \{\
      _id: "$gender",\
      "cantidad empleados": \{ $sum: 1 \}\
    \}\
  \},\
