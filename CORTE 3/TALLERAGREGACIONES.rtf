\
// 7a. Corredor con m\'e1s kil\'f3metros totales\
db.corredores.aggregate([\
  \{\
    $group: \{\
      _id: \{ $concat: ["$nombre", " ", "$apellido"] \},\
      "total kilometros": \{ $sum: "$kilometros" \}\
    \}\
  \},\
  \{\
    $sort: \{ "total kilometros": -1 \}\
  \},\
  \{\
    $limit: 1\
  \}\
])\
\
// 7b. Mes con mayor actividad (m\'e1s minutos totales)\
db.corredores.aggregate([\
  \{\
    $group: \{\
      _id: "$mes",\
      "total minutos": \{ $sum: "$minutos" \}\
    \}\
  \},\
  \{\
    $sort: \{ "total minutos": -1 \}\
  \},\
  \{\
    $limit: 3\
  \}\
])\
\
// 7c. M\'e1ximo y m\'ednimo de kil\'f3metros registrados por corredor\
db.corredores.aggregate([\
  \{\
    $group: \{\
      _id: \{ $concat: ["$nombre", " ", "$apellido"] \},\
      "max km": \{ $max: "$kilometros" \},\
      "min km": \{ $min: "$kilometros" \}\
    \}\
  \},\
  \{\
    $sort: \{ "max km": -1 \}\
  \}\
])}